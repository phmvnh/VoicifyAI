# Public Client ID của OAuth Client loại "Desktop app" trong Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Một số Desktop client yêu cầu giá trị này khi đổi code. Nó không phải bí mật bảo mật
# vì được phân phối cùng ứng dụng desktop; PKCE mới là lớp bảo vệ authorization code.
GOOGLE_OAUTH_CLIENT_SECRET=your-desktop-client-secret

# OAuth Client ID loại Web application, dùng cho Google Identity Services trên bản web.
# Authorized JavaScript origin phải là hostname HTTPS, không được là IP LAN thô.
VITE_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Bỏ trống hai biến này khi chạy web qua Vite; frontend sẽ dùng cùng origin
# và Vite proxy REST/WebSocket sang FastAPI. Chỉ khai báo khi deploy tách API.
VITE_API_BASE_URL=
VITE_STREAM_URL=

# Khai báo cả hai để bật HTTPS cho Vite (ví dụ certificate tạo bằng mkcert).
# VOICIFY_HTTPS_KEY_FILE=certs/10.59.69.84-key.pem
# VOICIFY_HTTPS_CERT_FILE=certs/10.59.69.84.pem

# Trên server, thêm domain frontend production (phân tách bằng dấu phẩy).
# VOICIFY_CORS_ORIGINS=https://app.example.com
